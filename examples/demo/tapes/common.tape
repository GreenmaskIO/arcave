# Settings every recording shares. Sourced by each tape; run them through record.sh.

Set Shell "bash"
Set FontFamily "Menlo"
Set FontSize 17
Set LineHeight 1.25
Set Width 1280
Set Height 760
Set Padding 28
Set Margin 24
Set MarginFill "#5500FE"
Set BorderRadius 12
Set WindowBar Colorful
Set TypingSpeed 40ms
Set Framerate 24
Set WaitTimeout 180s
Set Theme { "name": "arcave", "background": "#130F26", "foreground": "#ECEAF6", "cursor": "#8A5CFF", "selection": "#2F008C", "black": "#1E1838", "red": "#FF5C7A", "green": "#4ADE80", "yellow": "#FACC15", "blue": "#7AA2FF", "magenta": "#B794FF", "cyan": "#5EEAD4", "white": "#D6D3E8", "brightBlack": "#6E6891", "brightRed": "#FF8099", "brightGreen": "#86EFAC", "brightYellow": "#FDE68A", "brightBlue": "#A5C0FF", "brightMagenta": "#D2BCFF", "brightCyan": "#99F6E4", "brightWhite": "#FFFFFF" }
